          { "label": "Bước 2 — Cấu hình lần đầu", "cmd": "opencode", "note": "Gõ lệnh này → làm theo hướng dẫn chọn provider (Gemini/Claude/OpenAI) và nhập API key" },
          { "label": "Bước 3 — Khởi động lại KAgent", "cmd": null, "note": "Tắt và mở lại KAgent để nhận diện OpenCode" }
        ]
