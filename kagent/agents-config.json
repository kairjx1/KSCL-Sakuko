      "streamJson": false,
      "authErrorPatterns": ["GEMINI_API_KEY", "Auth method", "GOOGLE_GENAI", "authentication", "not authenticated"],
      "authGuide": {
        "title": "Gemini CLI chưa đăng nhập",
        "steps": [
          { "label": "Cách 1 — Đăng nhập Google (dễ nhất)", "cmd": "gemini", "note": "Mở terminal, gõ lệnh này → trình duyệt tự mở → đăng nhập Google là xong" },
          { "label": "Cách 2 — Dùng API Key", "cmd": null, "note": "Vào https://aistudio.google.com/apikey → tạo key → set GEMINI_API_KEY=<key> trong terminal rồi khởi động lại KAgent" }
        ]
      }
    },
