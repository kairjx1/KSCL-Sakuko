{
  "agents": {
    "claude": {
      "name": "Claude Code",
      "cmd": "claude",
      "color": "#a78bfa",
      "icon": "✳",
      "installCmd": "npm install -g @anthropic-ai/claude-code",
      "installUrl": "https://claude.ai/code",
      "desc": "Anthropic Claude — AI code agent mạnh nhất, hỗ trợ MCP",
      "modelFlag": "--model",
      "defaultModel": "claude-sonnet-4-6",
      "defaultThinking": "low",
      "models": [
        { "id": "claude-opus-5",             "name": "Opus 5",     "note": "Mạnh nhất, chậm hơn" },
        { "id": "claude-sonnet-5",           "name": "Sonnet 5",   "note": "Cân bằng tốt" },
        { "id": "claude-sonnet-4-6",         "name": "Sonnet 4.6", "note": "Ổn định, phổ biến" },
        { "id": "claude-haiku-4-5-20251001", "name": "Haiku 4.5",  "note": "Nhanh, ít token nhất" }
      ],
      "thinkingLevels": [],
      "interactiveArgs": [],
      "safeArgs": ["--print", "{prompt}", "--output-format", "text"],
      "safeArgsWithStdin": ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json"],
      "autoArgs": ["{prompt}", "--dangerously-skip-permissions", "--output-format", "stream-json", "--verbose"],
      "autoArgsWithStdin": ["--dangerously-skip-permissions", "--output-format", "stream-json", "--verbose", "--input-format", "stream-json"],
      "continueFlag": "--continue",
      "streamJson": true,
      "altPath": { "win32": "", "darwin": "", "linux": "" },
      "authErrorPatterns": ["not logged in", "API key", "ANTHROPIC_API_KEY", "login required", "authenticate"],
      "authGuide": {
        "title": "Claude Code chưa đăng nhập",
        "steps": [
          { "label": "Đăng nhập Claude Code", "cmd": "claude login", "note": "Mở terminal, gõ lệnh này → làm theo hướng dẫn trên trình duyệt" }
        ]
      }
    },
    "gemini": {
